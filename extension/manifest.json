{
  "manifest_version": 3,
  "name": "Rooster naar je rekenmachine",
  "version": "1.0.0",
  "minimum_chrome_version": "116",
  "description": "Stuurt het rooster en de cijfers uit je eigen Magister-tab over USB naar een TI-84 Evo-T.",
  "action": {
    "default_title": "Rooster naar je rekenmachine",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "service_worker.js",
    "type": "module"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.magister.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://*.magister.net/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/menu.js",
        "src/token.js"
      ],
      "matches": [
        "https://*.magister.net/*"
      ]
    }
  ]
}
